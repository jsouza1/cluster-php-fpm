# build image
docker build -t step01 .

# run image
docker run -p 8000:80 step01

# run docker compose
docker compose up --build

# criar projeto symfony
symfony new my_app --version=lts

# criar um container temporário do mysql 
docker run -e MYSQL_ROOT_PASSWORD=123456 -p 3306:3306 --rm mysql

# criar banco de dados
php .\bin\console doctrine:database:create

# criar entidade
php .\bin\console make:entity

# criar migration
php .\bin\console make:migration

# aplicar migration
php .\bin\console doctrine:migrations:migrate

# teste de carga
2load -c100 -m100 --h1 --duration=10 --warm-up-time=5 http://localhost:8080/statics/load